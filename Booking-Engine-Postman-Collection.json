{
	"info": {
		"_postman_id": "baeb4f8-1a5c-43f1-b99b-d82b4dcab2bd",
		"name": "Slot Booking Engine (Complete Flow)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Admin Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if(jsonData.data) {",
							"   pm.collectionVariables.set(\"token\", jsonData.data.access_token);",
							"   console.log('Token automatically saved!');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"login"
					]
				}
			}
		},
		{
			"name": "2. Get Stores",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/stores",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"stores"
					]
				}
			}
		},
		{
			"name": "3. Get Store Services",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/stores/{{store_id}}/services",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"stores",
						"{{store_id}}",
						"services"
					]
				}
			}
		},
		{
			"name": "4. Get Available Slots",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/stores/{{store_id}}/slots?date={{test_date}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"stores",
						"{{store_id}}",
						"slots"
					],
					"query": [
						{
							"key": "date",
							"value": "{{test_date}}"
						}
					]
				}
			}
		},
		{
			"name": "5. Lock Slot",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"date\": \"{{test_date}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/slots/{{slot_id}}/lock",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"slots",
						"{{slot_id}}",
						"lock"
					]
				}
			}
		},
		{
			"name": "6. Confirm Booking",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"store_id\": \"{{store_id}}\",\n    \"service_ids\": [\n        \"{{service_id}}\"\n    ],\n    \"slot_id\": \"{{slot_id}}\",\n    \"date\": \"{{test_date}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/bookings",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"bookings"
					]
				}
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "store_id",
			"value": "REPLACE_ME_WITH_STORE_UUID",
			"type": "string"
		},
		{
			"key": "service_id",
			"value": "REPLACE_ME_WITH_SERVICE_UUID",
			"type": "string"
		},
		{
			"key": "slot_id",
			"value": "REPLACE_ME_WITH_SLOT_UUID",
			"type": "string"
		},
		{
			"key": "test_date",
			"value": "2026-03-01",
			"type": "string"
		}
	]
}
